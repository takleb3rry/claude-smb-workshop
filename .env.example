# Copy to .env.local for local development. On Vercel, add these under Project → Settings → Environment Variables.

# Public address of the site (used for links in calendar files and share images).
SITE_URL=https://www.claudemycompany.com

# The Google Sheet's Apps Script web-app URL and the shared secret (set up in step 3).
# Leave both empty until the sheet is ready; the site then shows "New dates coming soon".
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# Local testing and preview deployments only: show sample workshops instead of the sheet.
# Never set this on the production site. Sample requests are logged, not saved.
DATA_MODE=
